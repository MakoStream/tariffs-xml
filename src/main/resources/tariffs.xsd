<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="http://lab2.ua/tariffs"
           targetNamespace="http://lab2.ua/tariffs"
           elementFormDefault="qualified">

    <!-- ===== Simple types ===== -->

    <xs:simpleType name="TextType">
        <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="50"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Amount in UAH, 0..n, up to 2 decimal places -->
    <xs:simpleType name="MoneyType">
        <xs:restriction base="xs:decimal">
            <xs:minInclusive value="0"/>
            <xs:fractionDigits value="2"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="CountType">
        <xs:restriction base="xs:nonNegativeInteger"/>
    </xs:simpleType>

    <xs:simpleType name="TarificationType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="TWELVE_SECOND"/>
            <xs:enumeration value="PER_MINUTE"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="StatusType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="ACTIVE"/>
            <xs:enumeration value="ARCHIVED"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="TariffIdType">
        <xs:restriction base="xs:ID">
            <xs:pattern value="tariff-[0-9]+"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- ===== Complex types ===== -->

    <xs:complexType name="CallPricesType">
        <xs:sequence>
            <xs:element name="Inside" type="MoneyType"/>
            <xs:element name="Outside" type="MoneyType"/>
            <xs:element name="Landline" type="MoneyType"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ParametersType">
        <xs:sequence>
            <xs:element name="FavoriteNumbers" type="CountType"/>
            <xs:element name="Tarification" type="TarificationType"/>
            <xs:element name="ConnectionFee" type="MoneyType"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="TariffType">
        <xs:sequence>
            <xs:element name="Name" type="TextType"/>
            <xs:element name="OperatorName" type="TextType"/>
            <xs:element name="Payroll" type="MoneyType"/>
            <xs:element name="CallPrices" type="CallPricesType"/>
            <xs:element name="SmsPrice" type="MoneyType"/>
            <xs:element name="Parameters" type="ParametersType"/>
        </xs:sequence>
        <xs:attribute name="id" type="TariffIdType" use="required"/>
        <xs:attribute name="status" type="StatusType" use="required"/>
    </xs:complexType>

    <!-- ===== Root ===== -->

    <xs:element name="Tariffs">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="Tariff" type="TariffType" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>
